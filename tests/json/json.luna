(include "../tester.luna")
(include "../../libs/json/json.luna")

(defvar parsed-data
  (try
   (json-parse-file "./test.json")
   (_ (json-parse-file "./json/test.json"))))
(defvar company (fst parsed-data))
(tester "JSON" "Company name" (fst (rst (get 1 company))) "TechCorp Solutions")
(tester "JSON" "Company founded" (fst (rst (get 2 company))) 2015)
(tester "JSON" "Company active" (type (fst (rst (get 3 company)))) (type false))
(tester "JSON" "Company country" (fst (rst (get 2 (rst (get 4 company))))) "USA")
